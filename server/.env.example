# ─── Database (Neon.tech) ───
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/binbin?sslmode=require

# ─── Better Auth ───
BETTER_AUTH_SECRET=generate-a-strong-secret-here-min-32-chars
BETTER_AUTH_URL=http://localhost:3001

# ─── Server ───
PORT=3001
NODE_ENV=development

# ─── Frontend Origin (CORS) ───
CLIENT_URL=http://localhost:8080

# ─── Payment Gateway (Midtrans — future) ───
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
